<%- include('../layouts/header') %>

<main>
  <div class="auth-tarjeta" style="text-align:left;">
    <img src="/img/home/noblestep-icono-N.png" alt="Noble Step" class="auth-logo" width="48" height="48">
    <div class="auth-cabecera">
      <h1>Restablecer contraseña</h1>
      <p>Elige tu nueva contraseña</p>
    </div>

    <% if (error) { %>
      <div class="auth-error">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg>
        <%= error %>
      </div>
    <% } %>

    <% if (!expirado) { %>
      <form action="/auth/restablecer-password/<%= token %>" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="auth-campo">
          <label for="nueva-password">Nueva contraseña</label>
          <input type="password" name="password" id="nueva-password" required minlength="8">
          <p class="auth-ayuda">Mínimo 8 caracteres, con letras y números.</p>
        </div>
        <button type="submit" class="auth-submit">Guardar nueva contraseña</button>
      </form>
    <% } else { %>
      <p style="text-align:center; font-size:0.9rem;"><a href="/auth/olvide-password">Solicitar un nuevo enlace</a></p>
    <% } %>
  </div>
</main>

<%- include('../layouts/footer') %>
