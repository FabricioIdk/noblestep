<%- include('../layouts/header') %>

<main>
  <div class="auth-tarjeta" style="text-align:left;">
    <img src="/img/home/noblestep-icono-N.png" alt="Noble Step" class="auth-logo" width="48" height="48">
    <div class="auth-cabecera">
      <h1>Recuperar contraseña</h1>
      <p>Te mandamos un enlace para crear una nueva</p>
    </div>

    <% if (error) { %>
      <div class="auth-error">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4"></path><path d="M12 16h.01"></path></svg>
        <%= error %>
      </div>
    <% } %>

    <% if (mensaje) { %>
      <p style="background:var(--gris-suave); padding:0.9rem; border-radius:var(--radio); font-size:0.88rem;"><%= mensaje %></p>
    <% } else { %>
      <form action="/auth/olvide-password" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="auth-campo">
          <label for="olv-email">Correo registrado</label>
          <input type="email" name="email" id="olv-email" required>
        </div>
        <button type="submit" class="auth-submit">Enviar enlace de recuperación</button>
      </form>
    <% } %>

    <p style="text-align:center; font-size:0.82rem; margin-top:1.3rem;"><a href="/auth/login">Volver a iniciar sesión</a></p>
  </div>
</main>

<%- include('../layouts/footer') %>
