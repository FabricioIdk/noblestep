<%- include('../layouts/header') %>

<main>
<% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

  <table border="1" cellpadding="8">
    <thead>
      <tr><th>Código</th><th>Tipo</th><th>Valor</th><th>Vigencia</th><th>Activo</th><th></th></tr>
    </thead>
    <tbody>
      <% cupones.forEach(function(c) { %>
        <tr>
          <td><%= c.codigo %></td>
          <td><%= c.tipo_descuento %></td>
          <td><%= c.tipo_descuento === 'porcentaje' ? c.valor + '%' : 'S/ ' + c.valor %></td>
          <td><%= c.fecha_inicio %> a <%= c.fecha_fin %></td>
          <td><span class="badge <%= c.activo ? 'badge-exito' : 'badge-gris' %>"><%= c.activo ? 'Sí' : 'No' %></span></td>
          <td>
            <form action="/admin/cupones/<%= c.id %>/toggle" method="POST" style="display:inline;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit"><%= c.activo ? 'Desactivar' : 'Activar' %></button>
            </form>
            <form action="/admin/cupones/<%= c.id %>/eliminar" method="POST" style="display:inline;"
                  data-confirm="¿Eliminar este cupón?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <h2>Nuevo cupón</h2>
  <form action="/admin/cupones" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="codigo" placeholder="Código (ej. VERANO20)" required>
    <select name="tipo_descuento">
      <option value="porcentaje">Porcentaje (%)</option>
      <option value="monto_fijo">Monto fijo (S/)</option>
    </select>
    <input type="number" step="0.01" name="valor" placeholder="Valor" required style="width:100px;">
    <label>Desde:</label>
    <input type="date" name="fecha_inicio" required>
    <label>Hasta:</label>
    <input type="date" name="fecha_fin" required>
    <button type="submit">Crear cupón</button>
  </form>

  <br>
  <button data-href="/admin">Volver al panel</button>
</main>

<%- include('../layouts/footer') %>
