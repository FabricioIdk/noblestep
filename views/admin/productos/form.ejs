<%- include('../layouts/header') %>

<main>
<% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

  <form action="<%= producto ? '/admin/productos/' + producto.id : '/admin/productos' %>"
        method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div>
      <label>Nombre:</label>
      <input type="text" name="nombre" value="<%= producto ? producto.nombre : '' %>" required>
    </div>
    <div>
      <label>Descripción:</label><br>
      <textarea name="descripcion" rows="3" cols="40"><%= producto ? (producto.descripcion || '') : '' %></textarea>
    </div>
    <div>
      <label>Precio (S/):</label>
      <input type="number" step="0.01" name="precio" value="<%= producto ? producto.precio : '' %>" required>
    </div>
    <div>
      <label>Precio de oferta (S/, opcional — deja vacío si no está en oferta):</label>
      <input type="number" step="0.01" name="precio_oferta" value="<%= (producto && producto.precio_oferta) ? producto.precio_oferta : '' %>">
    </div>
    <div>
      <label>Marca:</label>
      <input type="text" name="marca" value="<%= producto ? (producto.marca || '') : '' %>">
    </div>
    <div>
      <label>Género:</label>
      <select name="genero">
        <option value="unisex" <%= (!producto || producto.genero === 'unisex') ? 'selected' : '' %>>Unisex</option>
        <option value="hombre" <%= (producto && producto.genero === 'hombre') ? 'selected' : '' %>>Hombre</option>
        <option value="mujer" <%= (producto && producto.genero === 'mujer') ? 'selected' : '' %>>Mujer</option>
        <option value="nino" <%= (producto && producto.genero === 'nino') ? 'selected' : '' %>>Niño</option>
      </select>
    </div>
    <div>
      <label>Categoría:</label>
      <select name="categoria_id" required>
        <option value="">-- Selecciona --</option>
        <% categorias.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= (producto && producto.categoria_id === c.id) ? 'selected' : '' %>>
            <%= c.nombre %>
          </option>
        <% }); %>
      </select>
    </div>
    <div>
      <label>
        <input type="checkbox" name="activo" <%= (!producto || producto.activo) ? 'checked' : '' %>>
        Producto activo (visible en el catálogo)
      </label>
    </div>
    <div>
      <label>Imagen principal (JPG, PNG o WEBP, máx. 3MB):</label>
      <input type="file" name="imagen" accept=".jpg,.jpeg,.png,.webp">
      <% if (producto && producto.imagen_principal) { %>
        <br><img src="/img/productos/<%= producto.imagen_principal %>" width="100" alt="actual">
        <p><small>Imagen actual. Sube otra solo si quieres reemplazarla.</small></p>
      <% } %>
    </div>
    <br>
    <button type="submit">Guardar</button>
    <button type="button" data-href="/admin/productos">Cancelar</button>
  </form>

  <% if (producto) { %>
    <h2>Galería (fotos adicionales)</h2>
    <p><small>Hasta 2 fotos extra, además de la principal (3 en total) — así el detalle del producto muestra varias miniaturas, como en cualquier tienda real.</small></p>

    <% if (producto.galeria && producto.galeria.length > 0) { %>
      <div>
        <% producto.galeria.forEach(function(img) { %>
          <div style="display:inline-block; text-align:center; margin-right:12px;">
            <img src="/img/productos/<%= img.nombre_archivo %>" width="90" alt="foto de galería"><br>
            <form action="/admin/productos/<%= producto.id %>/imagenes/<%= img.id %>/eliminar" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit">Quitar</button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>

    <% if (!producto.galeria || producto.galeria.length < 2) { %>
      <form action="/admin/productos/<%= producto.id %>/imagenes" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="file" name="imagen" accept=".jpg,.jpeg,.png,.webp" required>
        <button type="submit">Agregar foto a la galería</button>
      </form>
    <% } else { %>
      <p><small>Ya tienes el máximo de 3 fotos (principal + 2). Quita una para poder subir otra.</small></p>
    <% } %>
  <% } %>

  <% if (producto) { %>
    <hr>
    <h2>Variantes (tallas / color)</h2>
    <p><small>El stock se administra por tienda desde el módulo de <a href="/admin/inventario">Inventario</a>. El stock inicial de una variante nueva entra al Almacén Central (online).</small></p>

    <% if (producto.variantes && producto.variantes.length > 0) { %>
      <table border="1" cellpadding="6">
        <thead>
          <tr><th>Talla</th><th>Color</th><th>SKU</th><th></th></tr>
        </thead>
        <tbody>
          <% producto.variantes.forEach(function(v) { %>
            <tr>
              <td><%= v.talla %></td>
              <td><%= v.color %></td>
              <td><%= v.sku %></td>
              <td>
                <form action="/admin/productos/<%= producto.id %>/variantes/<%= v.id %>/eliminar" method="POST"
                      data-confirm="¿Eliminar esta variante?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <p>Este producto todavía no tiene variantes (tallas) registradas.</p>
    <% } %>

    <h3>Agregar variante</h3>
    <form action="/admin/productos/<%= producto.id %>/variantes" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="text" name="talla" placeholder="Talla (ej. 40)" required>
      <input type="text" name="color" placeholder="Color" required>
      <input type="number" name="stock" placeholder="Stock inicial (Almacén Central)" min="0" required>
      <input type="text" name="sku" placeholder="SKU (código único)" required>
      <button type="submit">Agregar</button>
    </form>
  <% } %>

  <br>
  <button data-href="/admin/productos">Volver al listado</button>
</main>

<%- include('../layouts/footer') %>
