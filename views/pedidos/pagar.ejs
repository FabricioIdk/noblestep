<%- include('../layouts/header') %>
<%
  var costoEnvio = pedido.Envio ? Number(pedido.Envio.costo_envio) : 0;
%>

<main>
  <a href="/pedidos/<%= pedido.id %>" class="pedido-volver">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg>
    Volver al pedido
  </a>
  <h1>Pagar pedido</h1>
  <p class="pedido-fecha">Pedido <%= pedido.numero_pedido %></p>

  <% if (error) { %>
    <p class="pedido-aviso pedido-aviso-alerta"><%= error %></p>
  <% } %>

  <div class="checkout-layout">

    <form action="/pedidos/<%= pedido.id %>/pagar" method="POST" id="formPago">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="bloque-formulario pago-mp">
        <p>Pago seguro con Mercado Pago</p>
        <ul class="pago-mp-medios">
          <li><i class="fi fi-rr-credit-card"></i> Tarjetas de crédito y débito</li>
          <li><i class="fi fi-rr-smartphone"></i> Yape</li>
          <li><i class="fi fi-rr-wallet"></i> Saldo de Mercado Pago</li>
        </ul>
        <p class="nota-pago">Te llevaremos a la página segura de Mercado Pago para completar el pago. Al terminar, volverás automáticamente a tu pedido. Noble Step no ve ni guarda los datos de tu tarjeta.</p>
      </div>

      <% if (pagosDisponibles) { %>
        <div class="acciones-pago">
          <button type="submit" id="botonPagar">Pagar S/ <%= Number(pedido.total).toFixed(2) %></button>
          <button type="button" data-href="/pedidos/<%= pedido.id %>">Cancelar</button>
        </div>
      <% } else { %>
        <p class="pedido-aviso">Los pagos en línea no están disponibles en este momento. Escríbenos por <a href="https://wa.me/51937667857" target="_blank" rel="noopener">WhatsApp</a> para completar tu compra.</p>
      <% } %>
    </form>

    <aside class="checkout-resumen">
      <h2>Resumen</h2>
      <div class="carrito-resumen-fila">
        <span style="color:var(--tinta-suave);">Subtotal</span>
        <span style="font-weight:600;">S/ <%= Number(pedido.subtotal).toFixed(2) %></span>
      </div>
      <div class="carrito-resumen-fila">
        <span style="color:var(--tinta-suave);">Envío</span>
        <span style="font-weight:600;<%= costoEnvio === 0 ? ' color:var(--exito);' : '' %>"><%= costoEnvio === 0 ? 'Gratis' : 'S/ ' + costoEnvio.toFixed(2) %></span>
      </div>
      <div class="carrito-resumen-fila">
        <span style="color:var(--tinta-suave);">IGV (18%)</span>
        <span style="font-weight:600;">S/ <%= Number(pedido.igv).toFixed(2) %></span>
      </div>
      <div class="carrito-resumen-total">
        <span style="font-weight:600;">Total a pagar</span>
        <strong>S/ <%= Number(pedido.total).toFixed(2) %></strong>
      </div>
    </aside>

  </div>
</main>

<% if (pagosDisponibles) { %>
  <script nonce="<%= nonce %>">
    document.getElementById('formPago').addEventListener('submit', function () {
      var boton = document.getElementById('botonPagar');
      setTimeout(function () {
        boton.disabled = true;
        boton.textContent = 'Conectando con Mercado Pago...';
      }, 0);
    });
  </script>
<% } %>

<%- include('../layouts/footer') %>
