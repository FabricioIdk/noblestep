<%- include('../layouts/header') %>

<main>
  <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:0.6rem; margin-bottom:1.6rem;">
    <h1 style="margin:0;">Mi carrito</h1>
    <% if (items.length > 0) { %>
      <span style="color:var(--tinta-suave); font-size:0.9rem;">
        <%= items.length %> producto<%= items.length === 1 ? '' : 's' %>
      </span>
    <% } %>
  </div>

  <% if (items.length === 0) { %>
    <div class="carrito-vacio">
      <p>Tu carrito está vacío.</p>
      <button data-href="/productos">Ir al catálogo</button>
    </div>
  <% } else { %>
    <div class="carrito-layout">

      <div>
        <% items.forEach(function(item) { %>
          <div class="carrito-item">
            <div class="carrito-item-foto">
              <% if (item.producto && item.producto.imagen_principal) { %>
                <img src="/img/productos/<%= item.producto.imagen_principal %>" alt="<%= item.producto.nombre %>">
              <% } else { %>
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="var(--tinta-mute)" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
              <% } %>
            </div>

            <div class="carrito-item-info">
              <div class="carrito-item-cabecera">
                <div>
                  <% if (item.producto && item.producto.marca) { %>
                    <div class="carrito-item-marca"><%= item.producto.marca %></div>
                  <% } %>
                  <div class="carrito-item-nombre"><%= item.producto ? item.producto.nombre : 'Producto no disponible' %></div>
                  <div class="carrito-item-variante"><%= item.VarianteProducto.talla %> · <%= item.VarianteProducto.color %></div>
                </div>
                <div class="carrito-item-precio">
                  <div class="carrito-item-subtotal">S/ <%= (item.precio_unitario * item.cantidad).toFixed(2) %></div>
                  <div class="carrito-item-unitario">S/ <%= item.precio_unitario %> c/u</div>
                </div>
              </div>

              <div class="carrito-item-pie">
                <form action="/carrito/item/<%= item.id %>" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="carrito-stepper">
                    <button type="button" data-paso="-1" aria-label="Disminuir cantidad">−</button>
                    <input type="number" name="cantidad" value="<%= item.cantidad %>" min="1" max="<%= item.stockDisponible %>" data-autoenviar aria-label="Cantidad">
                    <button type="button" data-paso="1" aria-label="Aumentar cantidad">+</button>
                  </div>
                </form>

                <form action="/carrito/item/<%= item.id %>/eliminar" method="POST" style="margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="carrito-quitar">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path></svg>
                    Quitar
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }); %>

        <a href="/productos" class="carrito-seguir">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg>
          Seguir comprando
        </a>
      </div>

      <aside class="carrito-resumen">
        <h2>Resumen</h2>
        <div class="carrito-resumen-fila">
          <span style="color:var(--tinta-suave);">Subtotal</span>
          <span style="font-weight:600;">S/ <%= total.toFixed(2) %></span>
        </div>
        <p class="carrito-resumen-nota">El envío, el IGV y el descuento del cupón (si aplica) se calculan en el siguiente paso.</p>

        <div class="carrito-resumen-total">
          <span style="font-weight:600;">Total estimado</span>
          <strong>S/ <%= total.toFixed(2) %></strong>
        </div>

        <button data-href="/checkout" class="boton-pago">Proceder al pago</button>

        <form action="/carrito/vaciar" method="POST" data-confirm="¿Vaciar todo el carrito?" style="margin:0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="carrito-vaciar">Vaciar carrito</button>
        </form>
      </aside>

    </div>
  <% } %>
</main>

<%- include('../layouts/footer') %>
