  <script nonce="<%= nonce %>">
     
     
     
     
     
     
     
     
     
     
     
    function alternarFavorito(evento, formulario) {
      evento.preventDefault();

      var boton = formulario.querySelector('button');
       
       
      var datos = new URLSearchParams(new FormData(formulario));

      fetch(formulario.action, {
        method: 'POST',
        body: datos,
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
      })
        .then(function (respuesta) {
          if (!respuesta.ok) throw new Error('fallo la peticion');
          return respuesta.json();
        })
        .then(function (datosRespuesta) {
          if (datosRespuesta.favorito) {
            boton.classList.add('favorito-activo');
          } else {
            boton.classList.remove('favorito-activo');
          }
           
           
          boton.classList.add('favorito-latido');
          setTimeout(function () { boton.classList.remove('favorito-latido'); }, 300);
        })
        .catch(function () {
           
           
           
          formulario.submit();
        });

      return false;  
    }

     
     
     
     
     
     
    function quitarDeFavoritos(evento, formulario) {
      evento.preventDefault();
      var tarjeta = formulario.closest('.tarjeta-producto');
       
       
      var datos = new URLSearchParams(new FormData(formulario));

      fetch(formulario.action, {
        method: 'POST',
        body: datos,
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
      })
        .then(function (respuesta) {
          if (!respuesta.ok) throw new Error('fallo la peticion');
          return respuesta.json();
        })
        .then(function () {
          if (!tarjeta) return;
          tarjeta.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
          tarjeta.style.opacity = '0';
          tarjeta.style.transform = 'scale(0.92)';
          setTimeout(function () { tarjeta.remove(); }, 250);
        })
        .catch(function () {
          formulario.submit();  
        });

      return false;
    }

     
     
     
     
     
     
     
     
     
     
    function agregarAlCarrito(evento, formulario) {
      evento.preventDefault();
      var boton = document.getElementById('btnAgregar');
      var textoOriginal = boton ? boton.textContent : '';
       
       
      var datos = new URLSearchParams(new FormData(formulario));

      fetch(formulario.action, { method: 'POST', body: datos })
        .then(function (respuesta) {
          if (!respuesta.ok) {
             
             
             
             
             
            return respuesta.text().then(function (html) {
              document.open();
              document.write(html);
              document.close();
            });
          }
          if (boton) {
            boton.textContent = '✓ Añadido al carrito';
            boton.classList.add('boton-confirmado');
            setTimeout(function () {
              boton.textContent = textoOriginal;
              boton.classList.remove('boton-confirmado');
            }, 1800);
          }
        })
        .catch(function () {
          formulario.submit();  
        });

      return false;
    }

     
     
     
    document.addEventListener('submit', function (evento) {
      var formulario = evento.target;
      if (!formulario.hasAttribute) return;
      if (formulario.hasAttribute('data-favorito')) {
        alternarFavorito(evento, formulario);
      } else if (formulario.hasAttribute('data-quitar-favorito')) {
        quitarDeFavoritos(evento, formulario);
      }
    });
  </script>

  <script nonce="<%= nonce %>">
     
     
     
     
    function alternarTema() {
      var esOscuroAhora = document.documentElement.getAttribute('data-tema') === 'oscuro';
      if (esOscuroAhora) {
        document.documentElement.removeAttribute('data-tema');
        localStorage.setItem('noblestep-tema', 'claro');
      } else {
        document.documentElement.setAttribute('data-tema', 'oscuro');
        localStorage.setItem('noblestep-tema', 'oscuro');
      }
      actualizarIconoTema();
    }

    function actualizarIconoTema() {
      var icono = document.getElementById('iconoTema');
      var boton = document.getElementById('botonTema');
      if (!icono) return;
      var esOscuro = document.documentElement.getAttribute('data-tema') === 'oscuro';
      icono.className = esOscuro ? 'fi fi-rr-sun' : 'fi fi-rr-moon';
      if (boton) boton.title = esOscuro ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';
    }

     
     
     
    actualizarIconoTema();

    var botonTema = document.getElementById('botonTema');
    if (botonTema) botonTema.addEventListener('click', alternarTema);
  </script>
